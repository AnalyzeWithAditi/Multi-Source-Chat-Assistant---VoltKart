# Required
ANTHROPIC_API_KEY=

# Embeddings: "local" (free, default, no key) or "openai" (then set OPENAI_API_KEY)
EMBEDDINGS=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
DATA_DIR=data

# Optional LangSmith tracing (app works without these)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voltkart-rag
